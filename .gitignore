# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ File Tools - .gitignore                                                   ║
# ╠═══════════════════════════════════════════════════════════════════════════╣
# ║ Unified CLI for file organization and bulk renaming                       ║
# ║ Stack: Python 3.x, CLI utilities                                          ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─── Python Core ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# ─── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.Python

# ─── Distribution & Packaging ────────────────────────────────────────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.whl

# ─── Testing & Coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# ─── Type Checking & Linting ─────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pytype/

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
.env.local
*.local

# ─── Application-Specific ────────────────────────────────────────────────────
# Test/sample files used during development
test_files/
sample_data/
*.test/

# Operation logs and reports
reports/
operation_*.txt

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log

# ─── Temporary Files ─────────────────────────────────────────────────────────
*.tmp
*.temp
*~
*.swp
*.swo
.tmp_*
